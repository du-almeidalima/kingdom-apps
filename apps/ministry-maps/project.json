{
  "name": "ministry-maps",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "app",
  "sourceRoot": "apps/ministry-maps/src",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@nx/angular:webpack-browser",
      "outputs": ["{options.outputPath}"],
      "options": {
        "customWebpackConfig": {
          "path": "apps/ministry-maps/webpack.config.js"
        },
        "outputPath": "dist/apps/ministry-maps",
        "index": "apps/ministry-maps/src/index.html",
        "main": "apps/ministry-maps/src/main.ts",
        "polyfills": ["zone.js"],
        "tsConfig": "apps/ministry-maps/tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/ministry-maps/public"
          },
          {
            "glob": "**/*",
            "input": "apps/ministry-maps/src/assets",
            "output": "assets"
          },
          {
            "input": "libs/common-ui/src/assets",
            "glob": "**/*",
            "output": "assets/common-ui"
          }
        ],
        "styles": ["libs/common-ui/src/lib/styles/index.scss", "apps/ministry-maps/src/styles/main.scss"],
        "stylePreprocessorOptions": {
          "includePaths": ["libs/common-ui/src/lib/styles"]
        },
        "scripts": [],
        "serviceWorker": true,
        "ngswConfigPath": "apps/ministry-maps/ngsw-config.json"
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "2mb",
              "maximumError": "2.5mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "4kb",
              "maximumError": "8kb"
            }
          ],
          "outputHashing": "all"
        },
        "development": {
          "buildOptimizer": false,
          "optimization": false,
          "vendorChunk": true,
          "extractLicenses": false,
          "sourceMap": true,
          "namedChunks": true
        }
      },
      "defaultConfiguration": "production"
    },
    "serve": {
      "executor": "@nx/angular:dev-server",
      "configurations": {
        "production": {
          "buildTarget": "ministry-maps:build:production"
        },
        "development": {
          "buildTarget": "ministry-maps:build:development"
        }
      },
      "defaultConfiguration": "development",
      "continuous": true
    },
    "e2e-servers": {
      "executor": "nx:run-commands",
      "continuous": true,
      "options": {
        "command": "node apps/ministry-maps/e2e/scripts/e2e-servers.mjs",
        "cwd": "{workspaceRoot}"
      }
    },
    "e2e-ui": {
      "executor": "nx:run-commands",
      "options": {
        "command": "playwright test --ui --config=apps/ministry-maps/playwright.config.ts",
        "cwd": "{workspaceRoot}"
      }
    },
    "e2e-report": {
      "executor": "nx:run-commands",
      "options": {
        "command": "playwright show-report dist/.playwright/apps/ministry-maps/playwright-report",
        "cwd": "{workspaceRoot}"
      }
    },
    "extract-i18n": {
      "executor": "@angular-devkit/build-angular:extract-i18n",
      "options": {
        "buildTarget": "ministry-maps:build"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "apps/ministry-maps/jest.config.ts",
        "tsConfig": "apps/ministry-maps/tsconfig.spec.json"
      }
    },
    "typecheck-e2e": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["default", "^default"],
      "options": {
        "command": "tsc --noEmit -p apps/ministry-maps/e2e/tsconfig.json"
      }
    },
    "deploy": {
      "executor": "@angular/fire:deploy",
      "options": {
        "version": 2
      },
      "configurations": {
        "production": {
          "buildTarget": "ministry-maps:build:production",
          "serveTarget": "ministry-maps:serve:production"
        }
      },
      "defaultConfiguration": "production"
    },
    "serve-static": {
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "ministry-maps:build",
        "spa": true
      }
    }
  }
}
