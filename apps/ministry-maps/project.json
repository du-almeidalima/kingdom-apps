{
  "name": "ministry-maps",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "kingdom-apps",
  "sourceRoot": "apps/ministry-maps/src",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@nx/angular:application",
      "outputs": ["{options.outputPath.base}"],
      "options": {
        "outputPath": {
          "base": "dist/apps/ministry-maps",
          "browser": ""
        },
        "index": "apps/ministry-maps/src/index.html",
        "tsConfig": "apps/ministry-maps/tsconfig.app.json",
        "plugins": [
          {
            "path": "apps/ministry-maps/tools/esbuild/define-env.plugin.js"
          }
        ],
        "inlineStyleLanguage": "scss",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/ministry-maps/public"
          },
          {
            "glob": "**/*",
            "input": "apps/ministry-maps/src/assets",
            "output": "assets"
          },
          {
            "input": "libs/common-ui/src/assets",
            "glob": "**/*",
            "output": "assets/common-ui"
          }
        ],
        "styles": ["libs/common-ui/src/lib/styles/index.scss", "apps/ministry-maps/src/styles/main.scss"],
        "stylePreprocessorOptions": {
          "includePaths": ["."]
        },
        "scripts": [],
        "serviceWorker": "apps/ministry-maps/ngsw-config.json",
        "browser": "apps/ministry-maps/src/main.ts"
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "1.4mb",
              "maximumError": "1.6mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "4kb",
              "maximumError": "8kb"
            }
          ],
          "outputHashing": "all"
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true,
          "namedChunks": true
        }
      },
      "defaultConfiguration": "production"
    },
    "serve": {
      "executor": "@nx/angular:dev-server",
      "configurations": {
        "production": {
          "buildTarget": "ministry-maps:build:production"
        },
        "development": {
          "buildTarget": "ministry-maps:build:development"
        }
      },
      "defaultConfiguration": "development",
      "continuous": true
    },
    "e2e-servers": {
      "executor": "nx:run-commands",
      "continuous": true,
      "options": {
        "command": "node apps/ministry-maps/e2e/scripts/e2e-servers.mjs",
        "cwd": "{workspaceRoot}"
      }
    },
    "e2e-ui": {
      "executor": "nx:run-commands",
      "options": {
        "command": "playwright test --ui --config=apps/ministry-maps/playwright.config.ts",
        "cwd": "{workspaceRoot}"
      }
    },
    "e2e-report": {
      "executor": "nx:run-commands",
      "options": {
        "command": "playwright show-report dist/.playwright/apps/ministry-maps/playwright-report",
        "cwd": "{workspaceRoot}"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "apps/ministry-maps/jest.config.ts",
        "tsConfig": "apps/ministry-maps/tsconfig.spec.json"
      }
    },
    "typecheck-e2e": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["default", "^default"],
      "options": {
        "command": "tsc --noEmit -p apps/ministry-maps/e2e/tsconfig.json"
      }
    },
    "deploy": {
      "executor": "nx:run-commands",
      "dependsOn": [
        {
          "target": "build"
        }
      ],
      "options": {
        "command": "npx firebase deploy --only hosting:prod"
      },
      "configurations": {
        "production": {},
        "beta": {
          "command": "npx firebase deploy --only hosting:beta"
        }
      },
      "defaultConfiguration": "production"
    },
    "serve-static": {
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "ministry-maps:build",
        "spa": true
      }
    }
  }
}
