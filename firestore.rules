rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Public: the anonymous /work/:id designation links shared over WhatsApp.
    match /designations/{document=**} {
      allow read, write: if true;
    }

    // Territories: anonymous publishers holding a designation link read/update them and manage
    // visit history (create, edit, undo). Creating or deleting territories requires auth.
    // History is deliberately writable by anyone: the revert-visit flow runs anonymously, and the
    // same data is already public via designations.territories[].history.
    match /territories/{territoryId} {
      allow read, update: if true;
      allow create, delete: if request.auth != null;

      match /history/{historyId} {
        allow read, write: if true;
      }
    }

    // Collection-group queries for history subcollections (statistics single-query read).
    // Grants nothing new: direct access to territories/{id}/history is already public above.
    match /{path=**}/history/{historyId} {
      allow read, write: if true;
    }

    // Readable pre-auth so invite links can be validated before sign-in (the validation chain
    // also resolves the congregation reference). Invites are consumed only by the
    // provisionUserFromInvite Cloud Function, which bypasses rules via the Admin SDK.
    match /invitation_links/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /congregations/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Logs: writable by anyone (client logging), readable by APP_ADMIN only.
    match /logs/{document=**} {
      allow read: if callerRoleIn(['APP_ADMIN']);
      allow write: if true;
    }

    // Users: profiles are created only by the provisionUserFromInvite Cloud Function (Admin SDK
    // bypasses rules), so a role can never be forged from the client.
    // DEPLOY ORDER: functions first, then these rules — otherwise new signups break in between.
    match /users/{userId} {
      allow create: if false;

      allow get: if isSelf(userId)
        || (callerRoleIn(['ORGANIZER', 'ELDER', 'ADMIN', 'SUPERINTENDENT', 'APP_ADMIN'])
          && sameCongregationAsCaller(resource.data));
      allow list: if callerRoleIn(['ORGANIZER', 'ELDER', 'ADMIN', 'SUPERINTENDENT', 'APP_ADMIN'])
        && sameCongregationAsCaller(resource.data);

      // Self: role is immutable; congregation changes only for SUPERINTENDENT/APP_ADMIN
      // (ProfileBO.CHANGE_CONGREGATION_ALLOWED). ADMIN/SUPERINTENDENT may edit same-congregation
      // users but never touch a protected role in either direction. APP_ADMIN is unrestricted.
      allow update: if (
          isSelf(userId)
          && unchanged('role')
          && (unchanged('congregation') || isProtectedRole(resource.data.role))
        ) || (
          callerRoleIn(['ADMIN', 'SUPERINTENDENT'])
          && sameCongregationAsCaller(resource.data)
          && !isProtectedRole(resource.data.role)
          && !isProtectedRole(request.resource.data.role)
          && unchanged('congregation')
        ) || callerRoleIn(['APP_ADMIN']);

      // Mirrors the deleteUser Cloud Function: ADMIN/SUPERINTENDENT delete same-congregation
      // users but never protected roles; APP_ADMIN deletes anyone.
      allow delete: if (
          callerRoleIn(['ADMIN', 'SUPERINTENDENT'])
          && sameCongregationAsCaller(resource.data)
          && !isProtectedRole(resource.data.role)
        ) || callerRoleIn(['APP_ADMIN']);
    }

    // `designations_header` (resumable-assignment cycle headers) is internal congregational
    // data: authenticated users belonging to the same congregation (or APP_ADMIN) can read/write.
    match /designations_header/{headerId} {
      allow read: if request.auth != null
        && (callerRoleIn(['APP_ADMIN']) || isCallerInCongregation(resource.data.congregationId));
      allow create: if request.auth != null
        && (callerRoleIn(['APP_ADMIN']) || isCallerInCongregation(request.resource.data.congregationId));
      allow update, delete: if request.auth != null
        && (callerRoleIn(['APP_ADMIN']) || isCallerInCongregation(resource.data.congregationId));
    }

    // Catch-all for every other collection. `logs`, `users`, and `designations_header` are excluded
    // so the dedicated rules above stay their only granters (rules union grants, they never subtract).
    match /{collectionId}/{document=**} {
      allow read, write: if request.auth != null
        && collectionId != 'logs'
        && collectionId != 'users'
        && collectionId != 'designations_header';
    }

    // ── Helpers ─────────────────────────────────────────────────────────────────
    // get() calls made during rules evaluation bypass security rules.

    function isSelf(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function callerRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    /** True when the caller's role is one of `roles`. */
    function callerRoleIn(roles) {
      return request.auth != null && callerRole() in roles;
    }

    /** SUPERINTENDENT and APP_ADMIN profiles are only manageable by APP_ADMIN. */
    function isProtectedRole(role) {
      return role in ['SUPERINTENDENT', 'APP_ADMIN'];
    }

    /** True when the user `data` belongs to the caller's congregation (stored as a reference). */
    function sameCongregationAsCaller(data) {
      return request.auth != null
        && data.congregation == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.congregation;
    }

    /** True when the caller belongs to the given congregationId string. */
    function isCallerInCongregation(congregationId) {
      return request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.congregation
          == /databases/$(database)/documents/congregations/$(congregationId);
    }

    /** True when `field` is unchanged by the pending update (update rules only). */
    function unchanged(field) {
      return request.resource.data[field] == resource.data[field];
    }
  }
}
